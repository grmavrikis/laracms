APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Rate limits key on the client address. Behind a reverse proxy that address is
# the proxy's unless it is trusted here, which would put every visitor in one
# bucket. Set this only for a proxy that is really in front of the app -
# 127.0.0.1 for nginx on the same host, '*' only where the app cannot be
# reached directly. Left empty, X-Forwarded-For is ignored, which is the safe
# default for local development.
TRUSTED_PROXIES=

# Which language the admin panel opens in, and what a person who has chosen
# nothing reads (TASKS.md #96). It is a file in `lang/`, not a row in
# `languages` - those are the languages the *content* is translated into, which
# is a different question. Empty falls back to APP_FALLBACK_LOCALE.
SITE_LOCALE=

# The public site is written to files under `public/cache` and the web server
# hands them over before PHP starts (TASKS.md #97). This is the development
# switch; the owner has the same one on the settings screen, and the saved
# value wins. Off means the directory is emptied and nothing more is written,
# so every page is served by PHP - slower, never broken.
#
# `php artisan pages:warm` fills it, `pages:flush` empties it, and
# `pages:doctor` asks a running server whether it is actually serving the
# files. Run the doctor after any deployment to a new server: nginx needs a
# `try_files` that an .htaccess cannot reach, and a missing rewrite breaks
# nothing at all - it just quietly stops working.
PAGE_CACHE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
